# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://cantine.example.tn
FRONTEND_URL=http://localhost:5173
COMPANY_TIME_ZONE=Africa/Tunis
# Separate secret for OTP hashing and QR signatures (changing it invalidates existing QR codes)
CANTEEN_SIGNING_KEY=change-me-too

# --- Phone push notifications (spec §8). Generate with: python manage.py generate_vapid_keys
# Empty = push off (notifications stay in the app). Changing them makes every phone turn push on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cantine@example.tn

# --- Database: SQL Server (own database, own login, no rights on the ERP) ---
# DB_ENGINE=sqlite   # uncomment for a quick local run without SQL Server
DB_NAME=canteen
DB_USER=canteen_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes

# --- Email (company SMTP). Dev default prints emails in the console. ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.tn
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Cantine OVAGRI <cantine@example.tn>
